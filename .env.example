# LiveKit Cloud (free "Build" plan): https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Free-tier model providers
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Twilio Elastic SIP trunk (read by setup_trunk.py; never printed)
TWILIO_TERMINATION_URI=your-trunk.pstn.twilio.com
TWILIO_NUMBER=+1XXXXXXXXXX
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Filled in automatically by setup_trunk.py
SIP_OUTBOUND_TRUNK_ID=

# Destination number (E.164) substituted into all 10 fictional records.
DEMO_PHONE=+15551234567
# Allowlist: dial.py and the agent refuse any other number.
ALLOWED_NUMBERS=+15551234567
# Optional live transfer target (must also be in ALLOWED_NUMBERS)
HUMAN_TRANSFER_NUMBER=

COMPANY_NAME=Acme Services
# Demo convenience: bypass the 08:00-21:00 local-time rule
IGNORE_CALL_HOURS=0
# Which record `python agent.py console` uses
CONSOLE_CUSTOMER_ID=C001
